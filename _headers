# Cloudflare Pages _headers
# #266 (10.06.2026): Auto cache control. Index.html = no-cache (browser revalidate
# КОЖЕН раз), JS/CSS = immutable (cache forever, версія у URL вирішує).
# Це усуває потребу робити hard reload після кожного deploy — нова версія
# index.html завжди свіжа, нові script URLs автоматично завантажуються.
# 02.07.2026: re-deploy trigger — health no-store правила (нижче) не були застосовані
# на проді (CF Pages не задеплоїв), через що team.dreamcar.ua/health/report.html
# застрягав на max-age=600. Цей коміт форсує повний re-deploy.
# 06.07.2026: додано /health/vadym (коротке дзеркало дашборда) + re-deploy trigger.

# Index.html кожного app — NO-CACHE (завжди revalidate, edge bypass)
/hq/
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  CDN-Cache-Control: no-store

/hq/index.html
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  CDN-Cache-Control: no-store

